# Public site URL — no trailing slash.
# Local: http://localhost:3000
# Vercel Production: https://www.compare-magnitude.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense publisher id (ca-pub-…). Leave empty until approved.
# Auto ads: set this on Vercel Production, then turn Auto ads on in the AdSense UI.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional manual display unit id (digits only). Leave empty to rely on Auto ads.
NEXT_PUBLIC_ADSENSE_SLOT=

# Google Analytics 4 measurement id (G-…). Optional.
NEXT_PUBLIC_GA_ID=

# Search Console HTML-tag verification token. Domain-property DNS verify does not need this.
NEXT_PUBLIC_GSC_VERIFICATION=

# Shown on /contact. Leave empty to fall back to GitHub issues.
NEXT_PUBLIC_CONTACT_EMAIL=
